theorem batch19_errors : errorCount arch network batch19 = 0 := by
  rw [network, errorCount_codeOfList _ _ networkCodes_length]
  decide +kernel

def heldoutRows : List Observation :=
  batch00 ++ batch01 ++ batch02 ++ batch03 ++ batch04 ++ batch05 ++ batch06 ++ batch07 ++ batch08 ++ batch09 ++ batch10 ++ batch11 ++ batch12 ++ batch13 ++ batch14 ++ batch15 ++ batch16 ++ batch17 ++ batch18 ++ batch19

theorem heldoutRows_length : heldoutRows.length = 397 := by decide +kernel

theorem heldout_errors : errorCount arch network heldoutRows = 16 := by
  simp only [heldoutRows, errorCount_append, batch00_errors, batch01_errors, batch02_errors, batch03_errors, batch04_errors, batch05_errors, batch06_errors, batch07_errors, batch08_errors, batch09_errors, batch10_errors, batch11_errors, batch12_errors, batch13_errors, batch14_errors, batch15_errors, batch16_errors, batch17_errors, batch18_errors, batch19_errors]

/-- The saved held-out rows, indexed as a sample of size 397. -/
def heldoutSample : Fin 397 → Observation :=
  fun i => heldoutRows.get (Fin.cast heldoutRows_length.symm i)

theorem heldout_empirical_error :
    empRisk (classificationLoss arch) heldoutSample network = (16 / 397 : ℝ) := by
  unfold heldoutSample
  rw [empiricalRisk_eq_errorCount_cast arch network heldoutRows heldoutRows_length,
    heldout_errors]
  norm_num

/-- The grid of Catoni temperatures `t = 1/4, …, 2`, fixed in advance. -/
noncomputable def tGrid : Finset ℝ := (Finset.range 8).image fun k : ℕ => ((k : ℝ) + 1) / 4

theorem tGrid_card : tGrid.card = 8 := by
  rw [tGrid, Finset.card_image_of_injective _ fun a b h => by
    have : ((a : ℝ) + 1) / 4 = ((b : ℝ) + 1) / 4 := h
    exact_mod_cast (by linarith : (a : ℝ) = b)]
  simp

theorem tGrid_nonempty : tGrid.Nonempty := ⟨1 / 4, Finset.mem_image.2 ⟨0, by simp, by norm_num⟩⟩

/-- **PAC-Bayes for the learned prior.** With probability at least 95% over the
held-out sample, every posterior on codes satisfies Catoni's inequality for every
grid temperature, relative to the prior centred on `network` with `m = 20`. -/
theorem heldout_pacBayes (P : Population Observation) :
    sampleLaw P.law 397 (⋃ t ∈ tGrid, badEvent (classificationLoss arch) P.law
      (centredPrior 20 network) 397 t (1 / 20 / tGrid.card)) ≤ ENNReal.ofReal (1 / 20) :=
  mlp_pacBayes P arch network (by norm_num) 397 tGrid tGrid_nonempty (by norm_num)

theorem t_mem : (3 / 4 : ℝ) ∈ tGrid := Finset.mem_image.2 ⟨2, by simp, by norm_num⟩

theorem log_confidence_le : Real.log (1 / (1 / 20 / tGrid.card)) ≤ 3 + 3 * 0.6931471808 := by
  simpa [tGrid_card] using log_one_div_twenty_div_eight_le

theorem catoni_rhs_le : (3 / 4 : ℝ) * (16 / 397 : ℝ) +
    (arch.parameterCount * ((3 / 2 ^ 20) / (1 - 3 / 2 ^ 20)) + (3 + 3 * 0.6931471808)) / 397 ≤
      (4302999 / 100000000 : ℝ) := by
  norm_num [Arch.parameterCount, arch]

theorem exp_c_le : Real.exp (4302999 / 100000000 : ℝ) ≤ (521984601509 / 500000000000 : ℝ) :=
  (Real.exp_bound' (by norm_num) (by norm_num) (n := 8) (by norm_num)).trans
    (by norm_num [Finset.sum_range_succ, Nat.factorial])

theorem le_exp_t : (2116997310093 / 1000000000000 : ℝ) ≤ Real.exp (3 / 4 : ℝ) :=
  le_trans (by norm_num [Finset.sum_range_succ, Nat.factorial])
    (Real.sum_le_exp_of_nonneg (by norm_num) 8)

theorem inversion_le : (1 - 1 / (521984601509 / 500000000000 : ℝ)) / (1 - 1 / (2116997310093 / 1000000000000 : ℝ)) ≤
    (799 / 10000 : ℝ) := by
  norm_num

/-- **Certificate.** With probability at least 95% over 397 IID held-out
observations, if the saved network makes at most 16 errors on them then its
population error is at most 7.99%. -/
theorem heldout_certificate (P : Population Observation) :
    sampleLaw P.law 397 {s | empRisk (classificationLoss arch) s network ≤ (16 / 397 : ℝ) ∧
      (799 / 10000 : ℝ) < P.risk (classificationLoss arch network)} ≤ ENNReal.ofReal (1 / 20) :=
  dirac_certificate P arch network (m := 20) (n := 397) (by norm_num) (by norm_num) tGrid
    tGrid_nonempty (by norm_num) t_mem (by norm_num) log_confidence_le catoni_rhs_le
    (by norm_num) exp_c_le le_exp_t (by norm_num) inversion_le

/-- The realized held-out sample lies in the 5% failure event exactly when the
saved network's population error exceeds the certified bound. -/
theorem heldoutSample_fails_iff (P : Population Observation) :
    heldoutSample ∈ {s | empRisk (classificationLoss arch) s network ≤ (16 / 397 : ℝ) ∧
      (799 / 10000 : ℝ) < P.risk (classificationLoss arch network)} ↔
      (799 / 10000 : ℝ) < P.risk (classificationLoss arch network) := by
  simp [heldout_empirical_error]

