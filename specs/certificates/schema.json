{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matthieu-perso/open-theory/specs/certificates/schema.json",
  "title": "OpenTheory certificate v0.1",
  "description": "certificate.json inside a bundle directory. Files are referenced by path (inside the bundle) and sha256. The verifier writes the Lean statement from `claim`; the bundle carries data, never Lean source.",
  "type": "object",
  "required": [
    "format",
    "claim",
    "subject",
    "evidence",
    "assumptions",
    "pins"
  ],
  "properties": {
    "format": {
      "const": "opentheory-certificate/0.1"
    },
    "claim": {
      "type": "object",
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "enum": [
            "heldout-error",
            "pool-rate",
            "judged-rate",
            "rate-gap",
            "rate-ratio",
            "tree-robust",
            "tree-monotone"
          ]
        },
        "version": {
          "const": "0.1"
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "description": "claimed held-out error count k"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "pool-rate: claimed number of sampled failures k"
        },
        "witness": {
          "$ref": "#/$defs/fraction",
          "description": "pool-rate: optional Chernoff witness t = u/v in (0, 1]"
        },
        "bound": {
          "$ref": "#/$defs/fraction",
          "description": "claimed population error bound p"
        },
        "delta": {
          "$ref": "#/$defs/fraction",
          "description": "failure probability, 1/d with d ≥ 2"
        },
        "decision": {
          "enum": [
            "approve",
            "decline"
          ],
          "description": "tree-robust: the decision on every input of the box"
        },
        "tau": {
          "type": [
            "string",
            "number"
          ],
          "description": "tree-robust: approve when the raw score is at least tau (default 0)"
        },
        "box": {
          "type": "object",
          "description": "tree-robust, tree-monotone: {feature index: [lo, hi]}, null for an open end",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          }
        },
        "feature": {
          "type": "integer",
          "minimum": 0,
          "description": "tree-monotone: the feature"
        },
        "direction": {
          "enum": [
            "increasing",
            "decreasing"
          ],
          "description": "tree-monotone"
        }
      }
    },
    "subject": {
      "type": "object",
      "description": "heldout-error, tree-robust, tree-monotone: model; pool-rate, judged-rate, rate-gap, rate-ratio: commitment",
      "properties": {
        "model": {
          "$ref": "#/$defs/file"
        },
        "commitment": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "heldout-error: heldout; pool-rate: order, beacon, sample, optional attempts",
      "properties": {
        "heldout": {
          "allOf": [
            {
              "$ref": "#/$defs/file"
            }
          ],
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[0-9]+-[a-z0-9-]+$"
      },
      "description": "ids from specs/assumptions/README.md; must include those of the catalog guarantee"
    },
    "pins": {
      "type": "object",
      "required": [
        "lean_toolchain"
      ],
      "properties": {
        "lean_toolchain": {
          "type": "string"
        },
        "opentheory_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "issuer": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "fraction": {
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 0
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "relative to the bundle; may not escape it"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "x-pool-rate": "specs/claims/pool-rate.md: commitment.json, order.tsr (RFC 3161), beacon.json (drand round), sample.json {items: [{index, leaf, proof}], labels?}",
  "x-model-files": {
    "quantized-mlp": "model.json = {model_type: 'quantized-mlp', inputs, hidden, classes, hidden_bias_scale, output_bias_scale, codes: [0..3]*}; heldout.json = {rows: [[x_1..x_inputs, label]]}"
  }
}
